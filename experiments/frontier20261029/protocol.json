      "type": "sample-level adaptation",
      "hypothesis": "Apply a0.5nat per-window/per-dimension floor to variable rate, retaining entry constants. No batch-expected freebits; not identical to literature objective."
    },
    "motion-weighted": {
      "type": "sample-level adaptation",
      "hypothesis": "Weight FM residuals by within-window target-frame changes, normalized only inside each sample. Emphasize small moving objects; no state labels or inference-time future frames."
    },
    "shared-flow-noise": {
      "type": "necessary control",
      "hypothesis": "Share renderer noise/time within a video window; same per-frame marginal flow objective with a different gradient estimator."
    },
