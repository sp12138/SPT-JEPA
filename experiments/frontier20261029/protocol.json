      "type": "surrogate",
      "hypothesis": "Average plus/minus noisy prior means before pricing prediction error; removes local linear noise variation. Jensen changes the objective; not an unbiased original KL."
    },
    "overshoot": {
      "type": "known-principle adaptation",
      "hypothesis": "Mix one-step rate with deterministic multi-step predictions from3observations; match planning horizon. Both targets remain attached; no EMA/stop-gradient. Inspired by latent overshooting, not claimed invented."
    },
